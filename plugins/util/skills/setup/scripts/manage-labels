#!/usr/bin/env bash
# Usage: manage-labels <owner/repo> [--prune] [--dry-run]
# Default: upsert all managed labels (create if missing, update if present).
# --prune: also delete any labels not in the managed set,
#   excluding dynamic labels (blocked:*) and Dependabot-managed labels.
# --dry-run: print what would change; no write calls are made.
# Uses the REST API only (gh api): GraphQL is blocked in Claude Code on the web.
set -euo pipefail

REPO="$1"
MODE="upsert"
DRY_RUN=""
for arg in "${@:2}"; do
  [[ "$arg" == "--prune" ]] && MODE="prune"
  [[ "$arg" == "--dry-run" ]] && DRY_RUN="1"
done

# name|color|description
MANAGED_LABELS=(
  "status:draft|c5def5|Issue created, spec not yet written"
  "status:ready|1d76db|Spec written, ready to build"
  "status:building|c2e0c6|Build in progress"
  "status:blocked|b60205|Build stopped at a gate, needs input"
  "status:built|0e8a16|PR open, awaiting manual merge"
  "type:bug|d93f0b|A defect with reproduction steps"
  "dependencies|d93f0b|Pull requests that update a dependency file"
  "php|f9d0c4|PHP Dependabot change"
  "javascript|f9d0c4|Javascript Dependabot change"
)

# Repositories can extend the managed set without changing this shared skill.
if [[ -f ".orc/config/labels" ]]; then
  while IFS= read -r entry; do
    [[ -z "$entry" || "$entry" =~ ^[[:space:]]*# ]] && continue
    MANAGED_LABELS+=("$entry")
  done < ".orc/config/labels"
fi

urlencode() { jq -rn --arg s "$1" '$s | @uri'; }

# Edit a label; if it doesn't exist (HTTP 404) create it. Any other error is fatal.
upsert_label() {
  local name="$1" color="$2" desc="$3" out
  if out=$(gh api -X PATCH "repos/$REPO/labels/$(urlencode "$name")" \
        -f color="$color" -f description="$desc" 2>&1 >/dev/null); then
    return 0
  fi
  if [[ "$out" == *"404"* || "$out" == *"Not Found"* ]]; then
    gh api -X POST "repos/$REPO/labels" -f name="$name" -f color="$color" \
      -f description="$desc" >/dev/null
  else
    echo "Failed to edit label '$name': $out" >&2
    return 1
  fi
}

EXISTING=$(gh api --paginate "repos/$REPO/labels?per_page=100" --jq '.[].name')

if [[ "$MODE" == "upsert" ]]; then
  for entry in "${MANAGED_LABELS[@]}"; do
    IFS='|' read -r name color desc <<< "$entry"
    if echo "$EXISTING" | grep -Fxq "$name"; then
      if [[ -n "$DRY_RUN" ]]; then
        echo "Would edit: $name (color=$color, description=\"$desc\")" >&2
      else
        upsert_label "$name" "$color" "$desc"
      fi
    else
      if [[ -n "$DRY_RUN" ]]; then
        echo "Would create: $name (color=$color, description=\"$desc\")" >&2
      else
        gh api -X POST "repos/$REPO/labels" -f name="$name" -f color="$color" \
          -f description="$desc" >/dev/null
      fi
    fi
  done
  echo "Managed labels ${DRY_RUN:+(dry run) }upserted for $REPO" >&2

elif [[ "$MODE" == "prune" ]]; then
  MANAGED_NAMES=()
  for entry in "${MANAGED_LABELS[@]}"; do
    IFS='|' read -r name _ _ <<< "$entry"
    MANAGED_NAMES+=("$name")
  done

  # Labels that must never be pruned even if not in the managed set.
  # blocked:* are created on demand by skills.
  # github-actions is created and managed by Dependabot.
  is_protected() {
    local label="$1"
    [[ "$label" =~ ^blocked: ]]      && return 0
    [[ "$label" == "github-actions" ]] && return 0
    return 1
  }

  while IFS= read -r label; do
    is_protected "$label" && continue
    found=0
    for m in "${MANAGED_NAMES[@]}"; do
      [[ "$m" == "$label" ]] && found=1 && break
    done
    if [[ "$found" -eq 0 ]]; then
      if [[ -n "$DRY_RUN" ]]; then
        echo "Would delete: $label" >&2
      else
        gh api -X DELETE "repos/$REPO/labels/$(urlencode "$label")" >/dev/null
        echo "Deleted: $label" >&2
      fi
    fi
  done <<< "$EXISTING"
fi
