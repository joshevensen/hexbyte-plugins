#!/usr/bin/env bash
# Usage: migrate-labels <owner/repo> [--dry-run]
# Maps known pre-skill labels to managed equivalents and drops known-useless labels.
# Prints any unrecognized labels to stderr for manual review.
# --dry-run: print what would change; no write calls are made.
# Uses the REST API only (gh api): GraphQL is blocked in Claude Code on the web.
set -euo pipefail

REPO="$1"
DRY_RUN=""
[[ "${2-}" == "--dry-run" ]] && DRY_RUN="1"

# source|target  (empty target = drop silently)
MAPPINGS=(
  "bug|type:bug"                "bug-fix|type:bug"          "bugfix|type:bug"
  "enhancement|"                "feature|"                  "feature-request|"
  "task|"                       "type:task|"                "type:feature|"
  "documentation|"              "docs|"
  "refactor|"                   "refactoring|"
  "chore|"                      "maintenance|"              "housekeeping|"
  "type:chore|"
  "type:docs|"                  "type:refactor|"            "type:queue|"
  "type:group|"                 "type:article|"             "article|"
  "planned|status:ready"        "backlog|status:ready"
  "in-progress|status:building" "wip|status:building"
  "shipped|status:built"        "defective|status:blocked"  "status:defective|status:blocked"
  "status:progress|status:building"
  "urgent|"       "critical|"       "high-priority|"  "medium-priority|"
  "low-priority|" "minor|"          "trivial|"
  "p0|" "p1|" "p2|" "p3|"
  "small|" "large|" "x-large|" "xl|" "xs|"
  "good first issue|" "wontfix|" "won't fix|"
  "duplicate|" "invalid|" "help wanted|" "question|" "needs-triage|"
  "queue|" "posts|" "post|"
)

MANAGED_NAMES=(
  status:draft status:ready status:building status:blocked status:built
  type:bug dependencies php javascript
)

is_managed() {
  local label="$1"
  [[ "$label" =~ ^blocked: ]] && return 0
  [[ "$label" == "dependencies" ]] && return 0
  [[ "$label" == "github-actions" ]] && return 0
  for m in "${MANAGED_NAMES[@]}"; do
    [[ "$m" == "$label" ]] && return 0
  done
  return 1
}

lookup() {
  local needle
  needle=$(echo "$1" | tr '[:upper:]' '[:lower:]')
  for entry in "${MAPPINGS[@]}"; do
    local src tgt
    IFS='|' read -r src tgt <<< "$entry"
    if [[ "$src" == "$needle" ]]; then
      echo "$tgt"
      return 0
    fi
  done
  return 1
}

urlencode() { jq -rn --arg s "$1" '$s | @uri'; }

# The issues endpoint also returns PRs; drop entries carrying a pull_request key.
ISSUES_TSV=$(gh api --paginate "repos/$REPO/issues?state=open&per_page=100" --jq \
  '.[] | select(has("pull_request") | not)
       | [(.number | tostring), (.labels | map(.name) | join(","))] | @tsv')

UPDATED=0
UNKNOWN_LABELS=()

while IFS=$'\t' read -r NUM LABEL_CSV; do
  [[ -z "$NUM" ]] && continue

  IFS=',' read -ra CURRENT_LABELS <<< "$LABEL_CSV"
  ADD=()
  REMOVE=()

  for label in "${CURRENT_LABELS[@]}"; do
    [[ -z "$label" ]] && continue
    is_managed "$label" && continue

    target=""
    if target=$(lookup "$label"); then
      REMOVE+=("$label")
      if [[ -n "$target" ]]; then
        already=0
        for l in "${CURRENT_LABELS[@]}"; do [[ "$l" == "$target" ]] && already=1 && break; done
        [[ "$already" -eq 0 ]] && ADD+=("$target")
      fi
    else
      UNKNOWN_LABELS+=("$label (issue #$NUM)")
    fi
  done

  if [[ ${#ADD[@]} -gt 0 || ${#REMOVE[@]} -gt 0 ]]; then
    if [[ -n "$DRY_RUN" ]]; then
      echo "Would update #$NUM: add [${ADD[*]-}] remove [${REMOVE[*]-}]" >&2
    else
      if [[ ${#ADD[@]} -gt 0 ]]; then
        add_args=()
        for l in "${ADD[@]}"; do add_args+=(-f "labels[]=$l"); done
        gh api -X POST "repos/$REPO/issues/$NUM/labels" "${add_args[@]}" >/dev/null
      fi
      for l in "${REMOVE[@]-}"; do
        [[ -z "$l" ]] && continue
        gh api -X DELETE "repos/$REPO/issues/$NUM/labels/$(urlencode "$l")" >/dev/null
      done
    fi
    UPDATED=$((UPDATED + 1))
  fi
done <<< "$ISSUES_TSV"

echo "Label migration${DRY_RUN:+ (dry run)}: $UPDATED issues ${DRY_RUN:+would be }updated" >&2

if [[ ${#UNKNOWN_LABELS[@]} -gt 0 ]]; then
  echo "" >&2
  echo "Unrecognized labels (handle manually):" >&2
  printf '  %s\n' "${UNKNOWN_LABELS[@]}" >&2
fi
